<?xml version="1.0" encoding="UTF-8" standalone="no" ?>
<package format="1" xmlns="https://wiki.freecad.org/Package_Metadata">

  <name>RobotCAD</name>
  <description>RobotCAD is a FreeCAD workbench to generate robot description packages (xacro or URDF) for the Robot Operating System.</description>
  <version>12.10.1</version>
  <date>2026-10-04</date>
  <maintainer email="it.project.devel@gmail.com">Vasily S</maintainer>
  <license file="LICENSE">LGPL-2.1-or-later</license>
  <url type="repository" branch="main">https://github.com/drfenixion/freecad.robotcad</url>
  <url type="readme">https://github.com/drfenixion/freecad.robotcad/blob/main/README.md</url>
  <icon>resources/icons/robotcad_overcross_joint.svg</icon>

  <freecadmin>0.21.2</freecadmin>

  <!-- https://https://github.com/stack-of-tasks/pinocchio.
  According to pypi.org, can be installed with `conda install -c conda-forge pinocchio` or `pip install pin`.
  However, it didn't work on Gaël's setup and was installed from robotpkg. `sys.path` is modified by code to
  include the path to this library in /opt/robotpkg/....
  -->
  <!--<depend>pin</depend>-->

  <content>
    <workbench>
      <classname>CrossWorkbench</classname>
      <subdirectory>freecad/robotcad</subdirectory>
      <pythonmin>3.11</pythonmin>
      <conflict type="addon">CROSS</conflict>

      <!-- Python dependencies, checked and installed by the "Check and install
           dependencies" action (see freecad/cross/dependencies.py). The element
           text is the *package* (pip) name; when the *import* name differs, it
           is given by the "import" attribute (or via KNOWN_IMPORT_NAMES). -->
      <depend type="python">urdf_parser_py</depend>
      <depend type="python">xacro</depend>
      <depend type="python">xacrodoc</depend>
      <depend type="python">mujoco</depend>
      <depend type="python" import="ament_index_python">ros-ament-index-python</depend>
      <depend type="python">xmltodict</depend>
      <depend type="python" import="collada">pycollada</depend>
      <depend type="python">lxml</depend>
      <!-- MCP (Model Context Protocol) is optional. -->
      <depend optional="true" type="python">mcp</depend>
    </workbench>
  </content>

</package>
